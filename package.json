{
  "name": "pdf-outline-builder",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @pdf-outline-builder/api dev",
    "dev:ocr": "cd apps/ocr-api && .venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000",
    "dev:web": "pnpm --filter @pdf-outline-builder/web dev",
    "setup:ocr": "cd apps/ocr-api && python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
    "dev": "pnpm run dev:api & pnpm run dev:web",
    "typecheck": "pnpm -r typecheck"
  }
}
