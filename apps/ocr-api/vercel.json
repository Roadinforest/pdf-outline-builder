{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python build.py",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{__pycache__/**,**/__pycache__/**,*.pyc,**/*.pyc,*.pdf,**/*.pdf,.venv/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
