# Required for any persistence to Vercel Blob. Without it, only the local /api/blob/upload/local
# route works (development only).
# BLOB_READ_WRITE_TOKEN=

# Optional. Overrides the request-derived base URL. Useful when running the API behind a proxy.
# APP_BASE_URL=

# AI refinement (LangChain → MiniMax). The LLM is only consulted by POST /api/outline/refine,
# which is triggered manually from the web UI by clicking the "AI Analyse" button.
# Without MINIMAX_API_KEY the route returns 503 and the UI shows a clear error.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-Text-01
